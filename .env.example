# Copy to .env and fill in. Never commit .env.
PRISM_DATABASE_URL=postgresql+asyncpg://prism:change-me@localhost:5432/prism
PRISM_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRISM_SECRET_KEY=
PRISM_CORS_ORIGINS=["http://localhost:5173"]
PRISM_UPLOAD_DIR=data/uploads
PRISM_MAX_UPLOAD_MB=10
