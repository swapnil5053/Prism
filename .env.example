# Copy to .env and fill in. Never commit .env.
PRISM_DATABASE_URL=postgresql+asyncpg://prism:change-me@localhost:5432/prism
PRISM_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRISM_SECRET_KEY=
PRISM_CORS_ORIGINS=["http://localhost:5173"]
PRISM_UPLOAD_DIR=data/uploads
PRISM_MAX_UPLOAD_MB=10
# Local dev runs over plain http; set to true behind HTTPS.
PRISM_COOKIE_SECURE=false

# Worker. Defaults shown; see eval/README.md for how they compare.
# PRISM_DETECTOR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# PRISM_DETECTOR_QUANT=nf4
# PRISM_DETECTOR_MAX_SIDE=896
# PRISM_DETECTOR_PROMPT=v4
# PRISM_DETECTOR_TEXT=ocr

# Docker Compose only
POSTGRES_PASSWORD=
